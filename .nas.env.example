# Copy to .env in the project root. Do not commit .env.
# Replace YOUR_NAS_IP with the actual NAS address.
ITAM_PUBLIC_BASE_URL=http://YOUR_NAS_IP:1880
ITAM_ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password
# Use the UID/GID of the NAS account that owns data and certs.
ITAM_UID=1000
ITAM_GID=1000
