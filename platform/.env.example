# Example only. Set these in the shell or Compose environment; never commit real values.
# Generate independent random secrets. Use a URL-safe database password.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
PLATFORM_DB_PASSWORD=replace-with-an-independent-url-safe-secret
ITAM_ALLOWED_HOSTS=itam.example.com,127.0.0.1,localhost
ITAM_CSRF_ORIGINS=https://itam.example.com
ITAM_TRUST_HTTPS_PROXY=0
# Local-only Python development:
# ITAM_DEBUG=1
# DATABASE_URL=postgresql://itam:your-url-encoded-password@127.0.0.1:5432/itam
# LDAP authentication for explicitly linked directory identities (no auto-provision/write):
# LDAP_HOST=ldap.example.com
# LDAP_PORT=636
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=uid=readonly,dc=example,dc=com
# LDAP_BIND_PASSWORD=provided-outside-git
# LDAP_CA_FILE=/certs/ldap-ca.pem
# LDAP_ID_ATTRIBUTE=entryUUID
